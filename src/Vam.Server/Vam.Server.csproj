<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    AGPL, like the engine it hosts. This is the process that runs a meeting: it owns the devices,
    the graph, the recording and the clock, and it keeps running whether or not anything is looking
    at it. G1 - a console being killed must not take the session with it.

    Windows-targeted because it hosts the WASAPI backend. The engine itself stays platform-free.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UserSecretsId>vam-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logging.Abstractions arrives with the web framework and must not be referenced twice. -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="Sentry.NLog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vam.Core\Vam.Core.csproj" />
    <ProjectReference Include="..\Vam.Engine\Vam.Engine.csproj" />
    <ProjectReference Include="..\Vam.Engine.Windows\Vam.Engine.Windows.csproj" />
    <ProjectReference Include="..\Vam.Protocol\Vam.Protocol.csproj" />
  </ItemGroup>

</Project>
