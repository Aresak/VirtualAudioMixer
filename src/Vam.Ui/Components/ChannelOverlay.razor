@inherits VamComponent

@*
    U3. Over the mixer, not away from it. An operator adjusting one microphone has not stopped
    needing to see the other fifteen, and a console that navigates to a settings page hides the
    meeting behind the thing being adjusted.
*@

@if (Channel is { } channel)
{
    <aside class="ovl" role="dialog" aria-label="@channel.Name">
        <div class="ohd">
            <span class="swatch" style="background:@Colour(channel)"></span>
            <span class="nm">@channel.Name</span>
            <button type="button" class="btn sm" @onclick="Shell.CloseOverlay">@L["common.close"]</button>
        </div>

        <div class="obody">
            <h2>@L["strip.name"]</h2>

            <div class="row">
                <input type="text"
                       value="@channel.Name"
                       aria-label="@L["strip.name"]"
                       @onchange="argument => Rename(channel, argument)" />
            </div>

            <div class="row" style="margin-top:8px">
                @foreach (string colour in StripPalette.All)
                {
                    <button type="button"
                            class="swatch"
                            style="background:@colour;width:22px;height:22px;border:1px solid @(colour == Colour(channel) ? "var(--ink)" : "var(--line)")"
                            aria-label="@colour"
                            @onclick="() => SetColour(channel, colour)"></button>
                }
            </div>

            <h2>@L["strip.device"]</h2>

            <div class="kv">
                <span class="k">@L["strip.device"]</span>
                <span class="v">@channel.DeviceName</span>
                <span class="k">@L["status.rate"]</span>
                <span class="v">@channel.MeasuredSampleRate.ToString("0.000", CultureInfo.InvariantCulture) Hz</span>
                <span class="k">Drift</span>
                <span class="v">@channel.DriftPpm.ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture) ppm</span>
            </div>

            <h2>@L["strip.trim"]</h2>

            <div class="knob">
                <div class="between">
                    <span>@L["strip.trim"]</span>
                    <span class="mono">@channel.TrimDb.ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture) dB</span>
                </div>
                <input type="range" min="-24" max="24" step="0.5"
                       value="@channel.TrimDb"
                       aria-label="@L["strip.trim"]"
                       @oninput="argument => SetTrim(channel, argument)" />
            </div>

            <h2>@L["automix.title"]</h2>

            <label class="row">
                <input type="checkbox"
                       checked="@channel.ParticipatesInAutomix"
                       @onchange='argument => SetFlagFromCheckbox(channel, "ParticipatesInAutomix", argument)' />
                <span>@L["strip.automixOn"]</span>
            </label>

            <p class="note">
                Off for anything that is not a microphone in the room. Sharing gain with a
                loudspeaker playing back what the mix just sent is a loop with a very slow period
                and an unpleasant sound.
            </p>

            <h2>@L["strip.chain"]</h2>

            <ChainEditor Channel="channel" />

            <h2>@L["common.remove"]</h2>

            <ConfirmButton Label="@L["common.remove"]"
                           Question="@RemovalQuestion(channel)"
                           Confirmed="() => Remove(channel)" />
        </div>
    </aside>
}

@code {
    ChannelState? Channel =>
        Session.Console is { } console && Shell.SelectedChannel >= 0 && Shell.SelectedChannel < console.Channels.Count
            ? console.Channels[Shell.SelectedChannel]
            : null;

    static string Colour(ChannelState channel) =>
        string.IsNullOrWhiteSpace(channel.Colour) ? StripPalette.For(channel.Index) : channel.Colour;

    string RemovalQuestion(ChannelState channel) =>
        $"Remove {channel.Name}? Its sends go with it, and the recording keeps the track it has already written.";

    async Task Rename(ChannelState channel, ChangeEventArgs arguments) =>
        await Session.ApplyAsync(new Command
        {
            SetChannelName = new SetChannelName
            {
                ChannelIndex = channel.Index,
                Name = arguments.Value?.ToString() ?? channel.Name
            }
        });

    async Task SetColour(ChannelState channel, string colour) =>
        await Session.ApplyAsync(new Command
        {
            SetChannelColour = new SetChannelColour { ChannelIndex = channel.Index, Colour = colour }
        });

    async Task SetTrim(ChannelState channel, ChangeEventArgs arguments)
    {
        if (double.TryParse(arguments.Value?.ToString(), CultureInfo.InvariantCulture, out double decibels))
        {
            await Session.ApplyAsync(new Command
            {
                SetTrim = new SetTrim { ChannelIndex = channel.Index, Decibels = decibels }
            });
        }
    }

    async Task SetFlagFromCheckbox(ChannelState channel, string flag, ChangeEventArgs arguments) =>
        await Session.ApplyAsync(new Command
        {
            SetFlag = new SetFlag
            {
                ChannelIndex = channel.Index,
                Flag = flag,
                Enabled = arguments.Value is true
            }
        });

    async Task Remove(ChannelState channel)
    {
        await Session.ApplyAsync(new Command
        {
            RemoveChannel = new RemoveChannel { ChannelIndex = channel.Index }
        });

        Shell.CloseOverlay();
    }
}
