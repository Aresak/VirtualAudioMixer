@inherits VamComponent

@*
    U3. Over the mixer, not away from it. An operator adjusting one microphone has not stopped
    needing to see the other fifteen, and a console that navigates to a settings page hides the
    meeting behind the thing being adjusted.

    The chain is drawn with its anchors: the head that cannot be dragged downwards and the tail that
    cannot be dragged upwards. Both are places in the compiled plan rather than a rule this console
    is trusted to enforce — drawing them makes the arrangement visible instead of surprising.
*@

@if (Channel is { } channel)
{
    <aside class="ovl"
           role="dialog"
           aria-label="@channel.Name">
        <div class="ohd">
            <span class="swatch"
                  style="background:@Colour(channel)"></span>
            <span class="nm">@channel.Name</span>

            @* Stepping between strips without closing and reopening. Comparing two microphones means
               looking at both, and the overlay is where the numbers are. *@
            <button type="button"
                    class="btn sm"
                    disabled="@(channel.Index == 0)"
                    @onclick="() => Step(-1)">◀</button>
            <button type="button"
                    class="btn sm"
                    disabled="@(channel.Index>= Count - 1)" @onclick="() => Step(1)">▶</button>
            <button type="button"
                    class="btn sm"
                    @onclick="Shell.CloseOverlay">@L["common.close"]</button>
        </div>

        <div class="obody">
            <h2>@L["channel.input"]</h2>

            <div class="card">
                <div class="kv">
                    @*
                        A selector rather than a label. A microphone that came back on a different
                        endpoint, or one assigned to the wrong strip during setup, has to be fixable
                        in place - rebuilding the strip would take its sends, its chain and its name
                        with it.
                    *@
                    <span class="k">@L["strip.device"]</span>
                    <span class="v">
                        <select value="@channel.DeviceId"
                                aria-label="@L["strip.device"]"
                                @onchange="argument => SetDeviceAsync(channel, argument)">
                            @foreach (DeviceInfo device in Captures)
                            {
                                <option value="@device.Id">@device.Name</option>
                            }
                        </select>
                    </span>

                    <span class="k">@L["channel.rates"]</span>
                    <span class="v">@Rates(channel)</span>

                    <span class="k">@L["channel.drift"]</span>
                    <span class="v">@channel.DriftPpm.ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture) ppm</span>

                    <span class="k">@L["strip.name"]</span>
                    <span class="v">
                        <input type="text" value="@channel.Name" aria-label="@L["strip.name"]" style="width:170px"
                               @onchange="argument => RenameAsync(channel, argument)" />
                    </span>

                    <span class="k">@L["channel.colour"]</span>
                    <span class="v row"
                          style="gap:4px">
                        @foreach (string colour in StripPalette.All)
                        {
                            <button type="button"
                                    class="swatch"
                                    style="background:@colour;width:18px;height:18px;border:1px solid @(colour == Colour(channel) ? "var(--ink)" : "var(--line)")"
                                    aria-label="@colour"
                                    @onclick="() => SetColourAsync(channel, colour)"></button>
                        }
                    </span>
                </div>

                <div class="row"
                     style="margin-top:12px">
                    <span style="flex:1"></span>
                    <ConfirmButton Label="@RemoveLabel(channel)"
                                   Question="@RemovalQuestion(channel)"
                                   Confirmed="() => RemoveAsync(channel)" />
                </div>
            </div>

            <h2>@L["preset.title"]</h2>

            <div class="card">
                <PresetBar Target="@(new ChainTarget { Index = channel.Index, IsBus = false })"
                           Name="@channel.PresetName"
                           IsModified="channel.IsPresetModified" />
            </div>

            <h2>@L["strip.chain"] <span class="chip">@L["mixer.reorder"]</span></h2>

            @*
                The fixed head. Trim, polarity and mono fold describe the signal arriving rather than
                a treatment of it, so they cannot be dragged further down — their settings are edited
                here like any other link, and only the position is fixed.
            *@
            <div class="mod anchor">
                <div class="mh">
                    <span class="anchoricon"
                          title="@L["chain.anchoredWhy"]">⚓</span>
                    <span class="t">@L["chain.head"]</span>
                    <InlineHelp Title="@L["chain.head"]"
                                Body="@L["help.head"]" />
                </div>
                <div class="anchornote">@L["chain.alwaysFirst"]</div>
                <div class="mb">
                    <div class="knob">
                        <div class="between">
                            <span>@L["strip.trim"] <InlineHelp Title="@L["strip.trim"]"
                                                               Body="@L["help.trim"]" /></span>
                            <span class="mono">@channel.TrimDb.ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture) dB</span>
                        </div>
                        <input type="range" min="-24" max="24" step="0.5"
                               value="@channel.TrimDb"
                               aria-label="@L["strip.trim"]"
                               @oninput="argument => SetTrimAsync(channel, argument)" />
                    </div>

                    <Switch Label="@L["strip.polarity"]"
                            Help="@L["help.polarity"]"
                            Checked="channel.IsPolarityInverted"
                            Changed='value => SetFlagAsync(channel, "PolarityInverted", value)' />

                    <Switch Label="@L["strip.monoFold"]"
                            Help="@L["help.monoFold"]"
                            Checked="channel.IsMonoFold"
                            Changed='value => SetFlagAsync(channel, "MonoFold", value)' />

                    @*
                        B8. Only worth anything on a stereo bus, which in practice means the monitors:
                        a council watches the stream on a phone speaker, and an operator wearing
                        headphones for two hours does not want four microphones stacked in the middle
                        of their head.
                    *@
                    <div class="knob">
                        <div class="between">
                            <span>@L["strip.pan"] <InlineHelp Title="@L["strip.pan"]"
                                                              Body="@L["help.pan"]" /></span>
                            <span class="mono">@PanText(channel)</span>
                        </div>
                        <input type="range" min="-1" max="1" step="0.02"
                               value="@channel.Pan"
                               aria-label="@L["strip.pan"]"
                               @oninput="argument => SetPanAsync(channel, argument)" />
                    </div>
                </div>
            </div>

            <div class="flow"
                 aria-hidden="true">↓</div>

            @* B3. Worth stating where somebody might change the order and wonder why it did not move. *@
            <div class="tap">@L["chain.vadTap"]</div>

            <div class="flow"
                 aria-hidden="true">↓</div>

            <ChainEditor Target="@(new ChainTarget { Index = channel.Index, IsBus = false })"
                         Chain="channel.Chain" />

            <div class="flow"
                 aria-hidden="true">↓</div>

            @*
                The fixed tail. The automix gain is applied after the fader, so the operator's fader
                keeps meaning what it says.
            *@
            <div class="mod anchor">
                <div class="mh">
                    <span class="anchoricon"
                          title="@L["chain.anchoredWhy"]">⚓</span>
                    <span class="t">@L["chain.tail"]</span>
                    <InlineHelp Title="@L["chain.tail"]"
                                Body="@L["help.tail"]" />
                </div>
                <div class="anchornote">@L["chain.alwaysLast"]</div>
                <div class="mb">
                    <div class="knob">
                        <div class="between">
                            <span>@L["strip.fader"]</span>
                            <span class="mono">@FaderScale.Format(channel.FaderDb) dB</span>
                        </div>
                        <input type="range" min="0" max="1000" step="1"
                               value="@((int)Math.Round(FaderScale.ToPosition(channel.FaderDb) * 1000))"
                               aria-label="@L["strip.fader"]"
                               @oninput="argument => SetFaderAsync(channel, argument)" />
                    </div>

                    <div style="border-top:1px solid var(--line-soft);margin:10px 0 9px"></div>

                    @*
                        B7. Pre-fade listen, beside the fader because that is what it bypasses. An
                        operator checking a microphone that is faded all the way down still hears it.
                    *@
                    <Switch Label="@L["strip.pfl"]"
                            Help="@L["help.pfl"]"
                            Checked="channel.IsPreFadeListen"
                            Changed='value => SetFlagAsync(channel, "PreFadeListen", value)' />

                    <Switch Label="@L["strip.automixOn"]"
                            Help="@L["help.participate"]"
                            Checked="channel.ParticipatesInAutomix"
                            Changed='value => SetFlagAsync(channel, "ParticipatesInAutomix", value)' />

                    <div class="knob">
                        <div class="between">
                            <span>@L["strip.weight"] <InlineHelp Title="@L["strip.weight"]"
                                                                 Body="@L["help.weight"]" /></span>
                            <span class="mono">@channel.AutomixWeight.ToString("0.00", CultureInfo.InvariantCulture)</span>
                        </div>
                        <input type="range" min="0.25" max="4" step="0.05"
                               value="@channel.AutomixWeight"
                               aria-label="@L["strip.weight"]"
                               @oninput="argument => SetWeightAsync(channel, argument)" />
                    </div>
                </div>
            </div>

            <h2>@L["channel.sends"]</h2>

            <div class="card">
                @foreach (BusState bus in Buses)
                {
                    <div class="between"
                         style="padding:6px 0;border-bottom:1px solid var(--line-soft)">
                        <span class="lbl"
                              style="font-size:12px;color:@(IsOn(channel, bus) ? "var(--ink)" : "var(--ink-mute)")">
                            @bus.Name
                        </span>
                        <span class="row">
                            @if (bus.ExcludedChannels.Contains(channel.Index))
                            {
                                <span class="pill bad">@L["send.locked"]</span>
                            }
                            else
                            {
                                @*
                                    D2. The per-pair level, behind the button rather than on it. The
                                    strip's send button stays one click; this is where the level goes
                                    when somebody needs it.
                                *@
                                <input type="number" class="num" step="0.5" min="-60" max="12"
                                       value="@LevelOf(channel, bus)"
                                       aria-label="@(bus.Name + " " + L["send.level"])"
                                       @onchange="argument => SetSendLevelAsync(channel, bus, argument)" />
                                <span class="mono"
                                      style="font-size:11px;color:var(--ink-mute)">dB</span>
                                <span class="chip">@(bus.IsPreFader ? L["send.pre"] : L["send.post"])</span>
                            }
                        </span>
                    </div>
                }
                <p class="sub"
                   style="margin:10px 0 0">@L["send.preWhy"]</p>
            </div>
        </div>
    </aside>
}
