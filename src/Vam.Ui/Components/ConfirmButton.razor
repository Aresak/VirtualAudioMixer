@inherits VamComponent

@*
    U8. Anything that cannot be undone asks first, in a sentence, in place.

    Not a browser confirm dialog: those cannot be translated, cannot be styled, and under a WebView
    they steal focus from a console somebody is using with one hand. The question appears where the
    button was and the button becomes the answer.
*@

@if (isAsking)
{
    <div class="card"
         style="border-color:rgba(224,80,60,.4)">
        <p style="margin:0 0 10px">@Question</p>
        <div class="row">
            <button type="button"
                    class="btn danger"
                    @onclick="YesAsync">@L["common.confirm"]</button>
            <button type="button"
                    class="btn"
                    @onclick="() => isAsking = false">@L["common.cancel"]</button>
        </div>
    </div>
}
else
{
    <button type="button"
            class="btn danger"
            @onclick="() => isAsking = true">@Label</button>
}
