@*
    Every slider in the console. One command in flight at a time, and a reply that arrives while the
    pointer holds it does not move it. See SliderDrag for why.
*@

<input type="range"
       min="@Text(Minimum)"
       max="@Text(Maximum)"
       step="@Text(Step)"
       value="@Text(drag.Draw(Value))"
       aria-label="@Label"
       @onpointerdown="drag.Hold"
       @onpointerup="drag.Release"
       @onpointercancel="drag.Release"
       @onchange="drag.Release"
       @onkeydown="drag.Release"
       @onblur="drag.Release"
       @oninput="OnInputAsync" />
