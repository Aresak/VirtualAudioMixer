@inherits VamComponent

@*
    What is asked when somebody closes the window.

    The engine is a second process that outlives this one, which is right during a meeting and
    surprising afterwards: somebody who has finished expects closing the console to have finished.
    So it is asked rather than assumed either way, and the answer that ends the session is the one
    offered first, because that is what closing usually means.
*@

@if (Prompt.IsAsking)
{
    <div class="closer">
        <div class="closer-card">
            <h2>@L["close.title"]</h2>
            <p class="sub">@L["close.sub"]</p>

            <button class="closer-btn primary"
                    @onclick="StopAndCloseAsync">
                <b>@L["close.stopEngine"]</b>
                <span>@L["close.stopEngine.sub"]</span>
            </button>

            <button class="closer-btn"
                    @onclick="LeaveAndClose">
                <b>@L["close.leaveRunning"]</b>
                <span>@L["close.leaveRunning.sub"]</span>
            </button>

            <div class="row"
                 style="margin-top:14px">
                <button class="btn"
                        @onclick="Prompt.Dismiss">@L["common.cancel"]</button>
            </div>
        </div>
    </div>
}
