@*
    K4's shape, as bars.

    SVG rather than canvas, unlike the meters: this redraws once a second, not twenty-five times,
    and at that rate the render tree is the simpler thing to be right about. The rule the meters obey
    is about rate, not about canvas.
*@

<svg viewBox="0 0 320 90"
     style="width:100%;height:90px"
     role="img"
     aria-label="Callback times">
    @for (int index = 0; index < Buckets.Count; index++)
    {
        double height = Peak <= 0 ? 0 : Buckets[index] / (double)Peak * 74;
        double x = index * (320.0 / Math.Max(Buckets.Count, 1));

        <rect x="@F(x)" y="@F(78 - height)"
              width="@F(320.0 / Math.Max(Buckets.Count, 1) - 1)" height="@F(height)"
              fill="@Fill(index)" />
    }

    @*
        The block boundary, drawn where it actually is. A histogram of callback times without the
        budget on it is a picture of some numbers.
    *@
    <line x1="@F(Boundary)"
          y1="0"
          x2="@F(Boundary)"
          y2="78"
          stroke="var(--bad)"
          stroke-width="1"
          stroke-dasharray="3 3" />
    <text x="@F(Math.Min(Boundary + 4, 280))"
          y="10"
          fill="var(--bad)"
          font-size="9"
          font-family="monospace">1 block</text>
    <line x1="0"
          y1="78"
          x2="320"
          y2="78"
          stroke="var(--line)"
          stroke-width="1" />
</svg>
