@inherits VamComponent
@implements IDisposable

@*
    C9. The last thirty seconds, as a stacked band: who held the gain, and when it changed hands.

    This is the panel that earns the automixer its trust. An operator watching a level meter cannot
    tell whether the automixer handed the gain over sensibly or thrashed between two microphones —
    and an operator who cannot tell will reach for the faders, which is the one thing gain sharing
    exists to make unnecessary.

    Sampled here rather than sent by the engine: the shares are already in every meter frame, and a
    second history on the wire would be the same numbers arriving twice.
*@

<svg class="band" viewBox="0 0 @Width 96" preserveAspectRatio="none" role="img" aria-label="@L["automix.band"]">
    @for (int column = 0; column < history.Count; column++)
    {
        double[] shares = history[column];
        double bottom = 96;

        @for (int channel = 0; channel < shares.Length; channel++)
        {
            double height = shares[channel] * 96;

            if (height < 0.4)
            {
                continue;
            }

            bottom -= height;

            <rect x="@F(column * (Width / (double)Capacity))"
                  y="@F(bottom)"
                  width="@F(Width / (double)Capacity + 0.5)"
                  height="@F(height)"
                  fill="@StripPalette.For(channel)" />
        }
    }
</svg>

@if (Channels.Count > 0)
{
    <div class="row" style="margin-top:8px;gap:12px">
        @foreach (ChannelState channel in Channels)
        {
            <span class="row" style="gap:5px">
                <span class="swatch" style="background:@StripPalette.For(channel.Index);width:9px;height:9px"></span>
                <span style="font-size:11px;color:var(--ink-mute)">@channel.Name</span>
            </span>
        }
    </div>
}

@code {
    /// <summary>Columns kept. Thirty seconds at two a second.</summary>
    const int Capacity = 60;

    const int Width = 1100;

    static readonly TimeSpan Interval = TimeSpan.FromMilliseconds(500);

    readonly List<double[]> history = [];

    PeriodicTimer? timer;
    CancellationTokenSource? sampling;

    IReadOnlyList<ChannelState> Channels =>
        Session.Console?.Channels.Where(channel => channel.ParticipatesInAutomix).ToList() ?? [];

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        base.OnInitialized();

        sampling = new CancellationTokenSource();
        timer = new PeriodicTimer(Interval);

        _ = SampleAsync(sampling.Token);
    }

    /// <inheritdoc />
    protected override void Dispose(bool disposing)
    {
        sampling?.Cancel();
        sampling?.Dispose();
        timer?.Dispose();
    }

    async Task SampleAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (timer is not null && await timer.WaitForNextTickAsync(cancellationToken))
            {
                Sample();

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The view closed. The only way this loop ends.
        }
    }

    void Sample()
    {
        if (Session.Console?.Automix is not { } automix)
        {
            return;
        }

        double[] column = new double[automix.Shares.Count];

        for (int index = 0; index < column.Length; index++)
        {
            column[index] = automix.Shares[index];
        }

        history.Add(column);

        if (history.Count > Capacity)
        {
            history.RemoveRange(0, history.Count - Capacity);
        }
    }

    static string F(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture);
}
