@inherits VamComponent
@using Vam.Ui.Extensions
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="view">
    <div class="pad">
        <h1>@L["automix.title"]</h1>
        <p class="sub">@L["automix.sub"]</p>

        @*
            C10. The global switch is in the status bar rather than here, where it is one click from
            any view if the automixer misbehaves mid-session. This view says where it is, so an
            operator who came looking for it finds it rather than concluding there is not one.
        *@
        <p class="note">@L["automix.switchLives"]</p>

        @if (Automix is not { } automix)
        {
            <p class="sub">@L["mixer.notConnected"]</p>
        }
        else
        {
            <h2>@L["automix.band"]</h2>

            <AutomixBand />

            @*
                An empty band is worse than no band, so the one state that legitimately empties it
                says so in words. Everything else that empties it is the room being quiet, which the
                axis on the band already reads as.
            *@
            <p class="sub"
               style="margin-top:8px">@(automix.IsBypassed ? L["automix.bandOff"] : L["automix.bandWhy"])</p>

            <div class="grid2">
                <div class="card">
                    <h2>@L["automix.parameters"]</h2>

                    <div class="knob">
                        <div class="between">
                            <span>@L["automix.depth"] <InlineHelp Title="@L["automix.depth"]"
                                                                  Body="@L["help.depth"]" /></span>
                            <span class="mono">@automix.DepthDb.ToString("0.0", CultureInfo.InvariantCulture) dB</span>
                        </div>
                        <input type="range" min="-40" max="0" step="0.5"
                               value="@automix.DepthDb"
                               aria-label="@L["automix.depth"]"
                               @oninput="SetDepthAsync" />
                    </div>

                    @*
                        C2. Depth is a floor, not a gate. A microphone held at the floor is still in
                        the mix, quietly, which is why a chairman interrupting from a channel the
                        automixer had turned down is heard immediately rather than after a gate opens.
                    *@
                    <div class="knob">
                        <div class="between">
                            <span>@L["automix.response"] <InlineHelp Title="@L["automix.response"]"
                                                                     Body="@L["help.response"]" /></span>
                            <span class="mono">@automix.ResponseMs.ToString("0", CultureInfo.InvariantCulture) ms</span>
                        </div>
                        <input type="range" min="20" max="500" step="5"
                               value="@automix.ResponseMs"
                               aria-label="@L["automix.response"]"
                               @oninput="SetResponseAsync" />
                    </div>
                </div>

                <div class="card">
                    <h2>@L["automix.open"]</h2>

                    <div class="kv">
                        <span class="k">@L["automix.open"]</span>
                        <span class="v">@automix.OpenMicrophones.ToString("0.00", CultureInfo.InvariantCulture)</span>
                    </div>

                    @*
                        Continuous, from the participation ratio, rather than a count of channels
                        above a threshold. Two people half-sharing the gain is not the same room as
                        one person holding it, and a whole number cannot tell them apart.
                    *@
                    <p class="note">@L["automix.openWhy"]</p>
                </div>
            </div>

            <h2>@L["common.channel"]</h2>

            @*
                A bar each rather than a column of numbers. Who is holding the gain is a comparison
                between channels, and a person reads a comparison off lengths far faster than off
                four percentages they have to sort in their head. The numbers are still there, at
                the one place they answer a question a bar cannot: how far down the floor has taken
                this channel.
            *@
            <div class="card">
                @foreach (ChannelState channel in Channels)
                {
                    <div class="axrow"
                         @key="channel.Index">
                        <div class="n">
                            <span class="swatch"
                                  style="background:@channel.ToStripColour()"></span>
                            <span>
                                @channel.Name
                            </span>
                        </div>

                        <div class="sharebar"
                             title="@L["help.share"]">
                            <i data-vam-axshare="@channel.Index"></i>
                        </div>

                        <div class="mono axgain"
                             data-vam-axgain="@channel.Index">
                            —
                        </div>

                        <div>
                            <span class="pill @(channel.ParticipatesInAutomix ? "ok" : "idle")"
                                  title="@L["strip.automixOn"]">
                                @(channel.ParticipatesInAutomix ? L["automix.in"] : L["automix.out"])
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
