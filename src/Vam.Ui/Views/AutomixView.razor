@inherits VamComponent

<div class="view">
    <div class="pad">
        <h1>@L["automix.title"]</h1>
        <p class="sub">@L["automix.sub"]</p>

        @if (Automix is not { } automix)
        {
            <p class="sub">@L["mixer.notConnected"]</p>
        }
        else
        {
            <div class="grid2">
                <div class="card">
                    <h2>@L["automix.title"]</h2>

                    <label class="row">
                        <input type="checkbox" checked="@automix.IsBypassed" @onchange="ToggleBypass" />
                        <span>@L["automix.bypass"]</span>
                    </label>

                    <div class="knob">
                        <div class="between">
                            <span>@L["automix.depth"]</span>
                            <span class="mono">@automix.DepthDb.ToString("0.0", CultureInfo.InvariantCulture) dB</span>
                        </div>
                        <input type="range" min="-40" max="0" step="0.5"
                               value="@automix.DepthDb"
                               aria-label="@L["automix.depth"]"
                               @oninput="SetDepth" />
                    </div>

                    @*
                        C2. Depth is a floor, not a gate. A microphone held at the floor is still in
                        the mix, quietly, which is why a chairman interrupting from a channel the
                        automixer had turned down is heard immediately rather than after a gate opens.
                    *@
                    <div class="knob">
                        <div class="between">
                            <span>@L["automix.response"]</span>
                            <span class="mono">@automix.ResponseMs.ToString("0", CultureInfo.InvariantCulture) ms</span>
                        </div>
                        <input type="range" min="20" max="500" step="5"
                               value="@automix.ResponseMs"
                               aria-label="@L["automix.response"]"
                               @oninput="SetResponse" />
                    </div>
                </div>

                <div class="card">
                    <h2>@L["automix.open"]</h2>

                    <div class="kv">
                        <span class="k">@L["automix.open"]</span>
                        <span class="v">@automix.OpenMicrophones.ToString("0.00", CultureInfo.InvariantCulture)</span>
                    </div>

                    @*
                        Continuous, from the participation ratio, rather than a count of channels
                        above a threshold. Two people half-sharing the gain is not the same room as
                        one person holding it, and a whole number cannot tell them apart.
                    *@
                    <p class="note">
                        Derived from how the gain is actually shared, not from counting microphones
                        over a threshold. Two people each holding half of it reads as two.
                    </p>
                </div>
            </div>

            <h2>@L["common.channel"]</h2>

            <div class="tw">
                <table>
                    <thead>
                        <tr>
                            <th>@L["common.channel"]</th>
                            <th>@L["strip.automixOn"]</th>
                            <th>@L["automix.share"]</th>
                            <th>@L["automix.gain"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ChannelState channel in Channels)
                        {
                            <tr>
                                <td>@channel.Name</td>
                                <td>
                                    <span class="pill @(channel.ParticipatesInAutomix ? "ok" : "idle")">
                                        @(channel.ParticipatesInAutomix ? L["common.yes"] : L["common.no"])
                                    </span>
                                </td>
                                <td class="mono">@Share(automix, channel.Index)</td>
                                <td class="mono">@Gain(automix, channel.Index)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    AutomixState? Automix => Session.Console?.Automix;

    IReadOnlyList<ChannelState> Channels => Session.Console?.Channels ?? [];

    static string Share(AutomixState automix, int index) =>
        index < automix.Shares.Count
            ? (automix.Shares[index] * 100).ToString("0.0", CultureInfo.InvariantCulture) + "%"
            : "—";

    static string Gain(AutomixState automix, int index) =>
        index < automix.GainsDb.Count
            ? automix.GainsDb[index].ToString("+0.0;-0.0;0.0", CultureInfo.InvariantCulture) + " dB"
            : "—";

    Task ToggleBypass(ChangeEventArgs arguments) =>
        Send(arguments.Value is true, Automix?.DepthDb ?? -15, Automix?.ResponseMs ?? 120);

    Task SetDepth(ChangeEventArgs arguments) =>
        double.TryParse(arguments.Value?.ToString(), CultureInfo.InvariantCulture, out double depth)
            ? Send(Automix?.IsBypassed ?? true, depth, Automix?.ResponseMs ?? 120)
            : Task.CompletedTask;

    Task SetResponse(ChangeEventArgs arguments) =>
        double.TryParse(arguments.Value?.ToString(), CultureInfo.InvariantCulture, out double response)
            ? Send(Automix?.IsBypassed ?? true, Automix?.DepthDb ?? -15, response)
            : Task.CompletedTask;

    async Task Send(bool bypassed, double depth, double response) =>
        await Session.ApplyAsync(new Command
        {
            SetAutomix = new SetAutomix { Bypassed = bypassed, DepthDb = depth, ResponseMs = response }
        });
}
