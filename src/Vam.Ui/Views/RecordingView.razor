@inherits VamComponent
@inject IPlatformServices Platform

<div class="view">
    <div class="pad">
        <h1>@L["recording.title"]</h1>
        <p class="sub">@L["recording.sub"]</p>

        @if (Recording is not { } recording)
        {
            <p class="sub">@L["mixer.notConnected"]</p>
        }
        else
        {
            <div class="card">
                <div class="between">
                    <span class="row">
                        @if (recording.IsRecording)
                        {
                            <span class="dot rec"></span>
                        }
                        <span class="lbl">@(recording.IsRecording ? L["status.recording"] : L["status.idle"])</span>
                    </span>

                    @if (recording.IsRecording)
                    {
                        @*
                            U8. Stopping ends a file that cannot be resumed, so it asks first and
                            says what will happen rather than "are you sure".
                        *@
                        <ConfirmButton Label="@L["recording.stop"]"
                                       Question="@L["recording.stopWhy"]"
                                       Confirmed="StopAsync" />
                    }
                    else
                    {
                        <button type="button"
                                class="btn pri"
                                @onclick="StartAsync">@L["recording.start"]</button>
                    }
                </div>

                <div class="kv"
                     style="margin-top:14px">
                    <span class="k">@L["recording.folder"]</span>
                    <span class="v">@(recording.Directory.Length > 0 ? recording.Directory : Paths?.Recordings ?? "—")</span>
                    <span class="k">@L["recording.elapsed"]</span>
                    <span class="v">@Duration(recording)</span>
                    <span class="k">@L["recording.dropped"]</span>
                    <span class="v @(recording.DroppedFrames == 0 ? "zero" : null)">@recording.DroppedFrames</span>
                    <span class="k">@L["recording.free"]</span>
                    <span class="v">@Gigabytes(recording.FreeBytes)</span>
                </div>
            </div>

            <h2>@L["recording.captured"]</h2>

            <div class="grid2">
                <div class="card">
                    @*
                        E3. What is captured, stated rather than assumed. The raw inputs are the
                        record: if the automixer misbehaves during a session, the session is still
                        recoverable afterwards, and for a public body the multitrack is the record.
                    *@
                    @*
                        Offered, not merely stated. Tracks cannot be added to files that are already
                        open, so while a session runs these say what the next one will do and refuse
                        to move rather than accepting a change they cannot make.
                    *@
                    <div class="switches">
                        @if (Captures is { } captures)
                        {
                            <Switch Label="@L.Format("recording.allInputs", Channels)"
                                    Help="@L["help.rawInputs"]"
                                    Checked="captures.Inputs"
                                    DisabledBecause="@LockedBecause(recording)"
                                    Changed="value => SetCaptureAsync(new RecordingCapture(captures) { Inputs = value })" />

                            <Switch Label="@L["recording.streamBus"]"
                                    Help="@L["help.streamBus"]"
                                    Checked="captures.StreamBus"
                                    DisabledBecause="@LockedBecause(recording)"
                                    Changed="value => SetCaptureAsync(new RecordingCapture(captures) { StreamBus = value })" />

                            <Switch Label="@L.Format("recording.allBuses", Buses)"
                                    Help="@L["help.allBuses"]"
                                    Checked="captures.AllBuses"
                                    DisabledBecause="@LockedBecause(recording)"
                                    Changed="value => SetCaptureAsync(new RecordingCapture(captures) { AllBuses = value })" />
                        }

                        <Switch Label="@L["recording.startWithEngine"]"
                                Help="@L["help.autoStart"]"
                                Checked="recording.StartsAutomatically"
                                Changed="SetAutoStartAsync" />
                    </div>

                    @if (Captures is { } current)
                    {
                        <div class="kv"
                             style="margin-top:14px">
                            <span class="k">@L["recording.format"]</span>
                            <span class="v">
                                @*
                                    What the engine can write, not what the console imagines. One entry
                                    today, and the control is here so the second one needs no console
                                    change.
                                *@
                                <select value="@current.Format"
                                        disabled="@(recording.AvailableFormats.Count < 2 || recording.IsRecording)"
                                        title="@FormatTitle(recording)"
                                        aria-label="@L["recording.format"]"
                                        @onchange="OnFormatAsync">
                                    @foreach (string format in recording.AvailableFormats)
                                    {
                                        <option value="@format">@FormatLabel(format)</option>
                                    }
                                </select>
                            </span>

                            <span class="k">@L["recording.written"]</span>
                            <span class="v">@Gigabytes(recording.BytesWritten)</span>

                            <span class="k">@L.Format("recording.projected", ExpectedHours(recording))</span>
                            <span class="v">@Gigabytes(recording.ProjectedBytes)</span>
                        </div>
                    }
                    else
                    {
                        @* An engine older than this console: what it captures is not on the wire. *@
                        <p class="note">@L["recording.capturesOlderEngine"]</p>
                    }

                    @if (Captures is not null && LockedBecause(recording).Length > 0)
                    {
                        <p class="note">@LockedBecause(recording)</p>
                    }
                </div>

                <div class="card">
                    @* E5. *@
                    <b class="lbl"
                       style="font-size:13px">@L["recording.diskGuard"]</b>

                    <div class="knob"
                         style="margin-top:12px">
                        <div class="between">
                            <span>@L["recording.free"]</span>
                            <span class="mono">@Gigabytes(recording.FreeBytes)</span>
                        </div>
                        <div class="slider"><i style="width:@(DiskBar(recording))%"></i></div>
                    </div>

                    <p class="sub"
                       style="margin:10px 0 0">@L["recording.guardWhy"]</p>

                    <div class="row"
                         style="margin-top:12px">
                        @*
                            Only when there is something to record. With nothing selected and
                            nothing configured the rate is zero, and "enough space for 0.0 h" beside
                            a warning would be the disk telling a lie about itself.
                        *@
                        @if (Captures is null)
                        {
                            <span class="pill">@L["recording.guardOlderEngine"]</span>
                        }
                        else if (HoursLeft(recording) is { } hours)
                        {
                            <span class="pill @(hours > 4 ? "ok" : "warn")">
                                @L.Format("recording.roomFor", hours.ToString("0.0", CultureInfo.InvariantCulture))
                            </span>
                        }
                        else
                        {
                            <span class="pill">@L["recording.nothingToRecord"]</span>
                        }
                    </div>
                </div>
            </div>

            <h2>@L["recording.folder"]</h2>

            @*
                Shown, not set. The folder is the engine's and it is changed in Settings, where the
                rest of its paths are: two boxes for one path is two places to disagree, and an
                operator who set it in one of them would watch the recording land somewhere else.
            *@
            <div class="kv">
                <span class="k">@L["recording.folder"]</span>
                <span class="v mono">@(Paths?.Recordings ?? "—")</span>
            </div>

            <p class="note">@L["recording.folderInSettings"]</p>

            <h2>@L["recording.past"]</h2>

            @*
                E3. Every session lands in its own dated folder, and until now nothing in the console
                said those folders were there. The question asked after a meeting is whether last
                month's recording came out, and it was answered by leaving the console.
            *@
            @if (!HasPastSessions)
            {
                <p class="sub">@L["recording.pastOlderEngine"]</p>
            }
            else if (sessions is null && !sessionsAsked)
            {
                <p class="sub">@L["recording.pastLoading"]</p>
            }
            else if (sessions is null)
            {
                <p class="sub">@L["recording.pastFailed"]</p>

                <button type="button"
                        class="btn"
                        @onclick="LoadSessionsAsync">@L["recording.pastRetry"]</button>
            }
            else if (sessions.Count == 0)
            {
                <p class="sub">@L["recording.pastNone"]</p>
            }
            else
            {
                <div class="tw">
                    <table>
                        <thead>
                            <tr>
                                <th>
                                    @L["recording.date"]
                                </th>
                                <th>
                                    @L["recording.duration"]
                                </th>
                                <th>
                                    @L["recording.tracks"]
                                </th>
                                <th>
                                    @L["recording.size"]
                                </th>
                                <th>
                                    @L["recording.dropped"]
                                </th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (PastSession session in sessions)
                            {
                                <tr @key="session.Directory">
                                    <td>
                                        @Started(session)
                                    </td>
                                    <td class="mono">
                                        @Ran(session)
                                    </td>
                                    <td class="mono">
                                        @session.Tracks
                                    </td>
                                    <td class="mono">
                                        @Gigabytes(session.Bytes)
                                    </td>
                                    <td>
                                        @if (session.DroppedFrames < 0)
                                        {
                                            <span class="sub">—</span>
                                        }
                                        else
                                        {
                                            <span class="pill @(session.DroppedFrames == 0 ? "ok" : "warn")">
                                                @session.DroppedFrames
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (CanOpenFolders)
                                        {
                                            <button type="button"
                                                    class="btn sm"
                                                    title="@session.Directory"
                                                    @onclick="() => OpenAsync(session)">
                                                @L["recording.openFolder"]
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="sub mono">@session.Directory</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (sessionsTruncated)
                {
                    <p class="note">@L.Format("recording.pastTruncated", sessions.Count)</p>
                }

                @if (!CanOpenFolders)
                {
                    @*
                        Either this host cannot show a folder at all, or the folder is on the
                        engine's machine and this console is not it. Two different things to be
                        told, so the console tells them apart.
                    *@
                    <p class="note">@L[NoOpenBecause]</p>
                }
            }

            @if (refusal.Length > 0)
            {
                <p class="note"
                   style="border-color:var(--bad);color:var(--bad)">@refusal</p>
            }
        }
    </div>
</div>
