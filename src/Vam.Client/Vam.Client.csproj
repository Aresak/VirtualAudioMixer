<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    MPL-2.0, like the console it hosts.

    The desktop client, and a host and nothing more: a startup file, one platform-services class and
    the page the console is rendered into. Every view, view model and service in the product lives in
    Vam.Ui, and a .razor file here is a defect.

    It holds no engine. Even on the machine wired to the microphones it speaks gRPC to Vam.Server,
    because a local client using a private path would leave the remote path as the one nobody
    exercised until somebody needed it during a meeting - and because G1 has the session outliving
    every console, which cannot be true of a console that is the session.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <RootNamespace>Vam.Client</RootNamespace>

    <ApplicationTitle>VAM</ApplicationTitle>
    <ApplicationId>cz.vam.console</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vam.Ui\Vam.Ui.csproj" />
  </ItemGroup>

  <!--
    Builds the engine, and neither links nor copies it: the console starts it as a process, and in a
    source checkout an engine left over from an older build would otherwise be the one it starts. Not
    a ProjectReference, which puts a Vam.Server.exe without its dll beside the console.

    A running engine holds its output open and is meant to outlive the console, so while one runs
    the engine is skipped with a message. Building it anyway fails the console's build (#61).
  -->
  <UsingTask TaskName="VamFileIsLocked"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Path ParameterType="System.String" Required="true" />
      <Locked ParameterType="System.Boolean" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (System.IO.File.Exists(Path))
        {
            try
            {
                using (System.IO.File.Open(Path, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite, System.IO.FileShare.None))
                {
                }
            }
            catch (System.IO.IOException)
            {
                Locked = true;
            }
            catch (System.UnauthorizedAccessException)
            {
                Locked = true;
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="BuildEngine"
          BeforeTargets="Build"
          Condition="'$(BuildingSolutionFile)' != 'true'">
    <PropertyGroup>
      <EngineProject>..\Vam.Server\Vam.Server.csproj</EngineProject>
      <EngineProperties>Configuration=$(Configuration)</EngineProperties>
    </PropertyGroup>

    <MSBuild Projects="$(EngineProject)"
             Targets="GetTargetPath"
             Properties="$(EngineProperties)"
             RemoveProperties="RuntimeIdentifier;SelfContained;TargetFramework">
      <Output TaskParameter="TargetOutputs"
              PropertyName="EngineAssembly" />
    </MSBuild>

    <VamFileIsLocked Path="$(EngineAssembly)">
      <Output TaskParameter="Locked"
              PropertyName="EngineIsRunning" />
    </VamFileIsLocked>

    <Message Importance="high"
             Text="Vam.Server was not rebuilt: an engine is running from $(EngineAssembly). Stop it to build a new one."
             Condition="'$(EngineIsRunning)' == 'true'" />

    <MSBuild Projects="$(EngineProject)"
             Targets="Build"
             Properties="$(EngineProperties)"
             RemoveProperties="RuntimeIdentifier;SelfContained;TargetFramework"
             Condition="'$(EngineIsRunning)' != 'true'" />
  </Target>

</Project>
