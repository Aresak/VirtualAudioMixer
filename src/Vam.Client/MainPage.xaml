<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Vam.Client"
             x:Class="Vam.Client.MainPage"
             BackgroundColor="#0d1013">

    <!--
        A web view filling the window, and nothing else. U6's one fixed dark scheme starts here: the
        page's background is painted before the console loads so the window never flashes white in a
        room where somebody is cutting cameras in low light.
    -->
    <BlazorWebView x:Name="webView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
